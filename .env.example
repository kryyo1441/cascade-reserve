# Copy to .env and fill in. No private keys ever go here - every deploy
# script signs via `--account <keystore>` (cast wallet import), never a raw
# key in a file or env var.

ETHERSCAN_API_KEY=
SEPOLIA_RPC_URL=

# Public addresses only.
DEPLOYER_ADDRESS=
LENDER_ADDRESS=
DEPOSITOR_ADDRESS=

# Current protocol asset (decisions.md #10 - switched from USDC after Aave's
# Sepolia stablecoin markets turned out to be supply-capped).
EURS=
AAVE_EURS_STATIC_ATOKEN=

# Superseded USDC-wired addresses - kept only for reference, no longer read
# by any script. Safe to delete.
USDC=
AAVE_USDC_STATIC_ATOKEN=

# Filled in after `forge script script/deploy/Deploy.s.sol:DeploySepolia --broadcast --verify`.
REGISTRY=
CASCADE=
L1=
L2=
REPO=
ATTACKER_VAULT=
